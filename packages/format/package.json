    "json-schema",
    "validator",
    "claude-code",
    "codex"
  ],
  "homepage": "https://session.link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lftherios/session-link.git",
    "directory": "packages/format"
  },
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
